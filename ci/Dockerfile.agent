# Image for the local AI agents (systems-engineer, hdl-developer).
# opencode itself is NOT baked in here - it's bind-mounted from the host at
# runtime (host already has it installed and configured against the local
# llama-server models), so this image only needs the tools the agents drive:
# git, gh (to push branches / open PRs+issues), and the same HDL toolchain
# as the CI image so hdl-developer can actually build/simulate designs.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ghdl \
        git help2man perl make autoconf g++ flex bison ccache \
        libfl2 libfl-dev zlib1g zlib1g-dev \
        python3 python3-pip python3-venv \
        curl ca-certificates gnupg jq \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch stable https://github.com/verilator/verilator.git /tmp/verilator-src \
    && cd /tmp/verilator-src \
    && autoconf \
    && ./configure \
    && make -j"$(nproc)" \
    && make install \
    && rm -rf /tmp/verilator-src

RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

RUN ghdl --version && verilator --version && gh --version
